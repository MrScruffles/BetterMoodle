{
  "manifest_version": 3,
  "name": "BetterMoodle",
  "version": "0.0.11",
  "description": "Cross out completed Moodle calendar assignments and show quiz questions on one page",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.wolfware.ncsu.edu/*"
  ],
  "background": {
    "service_worker": "content/index.js",
    "scripts": [
      "content/index.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bettermoodle@ashi-division",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.wolfware.ncsu.edu/*"
      ],
      "js": [
        "content/calender.js",
        "content/quiz.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
